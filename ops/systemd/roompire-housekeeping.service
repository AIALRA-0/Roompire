[Unit]
Description=Run conservative Roompire server housekeeping
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/srv/aialra/apps/codexapp/state/browser-workspaces/2026-07-04-roompire
Environment=ROOMPIRE_HOUSEKEEPING_CONFIRM=cleanup
Environment=ROOMPIRE_HOUSEKEEPING_CLEAN_REPO_ARTIFACTS=auto
Environment=ROOMPIRE_HOUSEKEEPING_REPO_ARTIFACT_MIN_AVAILABLE_BYTES=6442450944
Environment=ROOMPIRE_HOUSEKEEPING_CLEAN_TMP=true
Environment=ROOMPIRE_HOUSEKEEPING_DOCKER_PRUNE=true
Environment=ROOMPIRE_HOUSEKEEPING_ROOMPIRE_EPHEMERAL_IMAGES=true
Environment=ROOMPIRE_HOUSEKEEPING_ROOMPIRE_EPHEMERAL_IMAGE_REPOSITORIES=roompire-migrator
Environment=ROOMPIRE_HOUSEKEEPING_JOURNAL_VACUUM=true
Environment=ROOMPIRE_HOUSEKEEPING_CLEAN_UV_CACHE=false
Environment=ROOMPIRE_HOUSEKEEPING_CLEAN_BROWSER_WORKSPACES=auto
Environment=ROOMPIRE_HOUSEKEEPING_WORKSPACE_ARTIFACT_MIN_AVAILABLE_BYTES=10737418240
Environment=ROOMPIRE_JOURNAL_VACUUM_SIZE=200M
ExecStart=/usr/bin/env bash ./scripts/server_housekeeping.sh
