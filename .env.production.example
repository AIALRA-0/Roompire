ROOMPIRE_DOMAIN="roompire.aialra.online"
NEXT_PUBLIC_APP_URL="https://roompire.aialra.online"

POSTGRES_USER="roompire"
POSTGRES_PASSWORD="replace-with-a-strong-postgres-password"
POSTGRES_DB="roompire_prod"
DATABASE_URL="postgresql://roompire:replace-with-a-strong-postgres-password@postgres:5432/roompire_prod"
REDIS_URL="redis://redis:6379"

ROOMPIRE_ENABLE_DEV_AUTH="false"
ROOMPIRE_DEV_SESSION_EMAIL="alice@example.test"
ROOMPIRE_FILE_SIGNING_SECRET="replace-with-a-random-32-byte-secret"
ROOMPIRE_EXPORT_SIGNING_SECRET="replace-with-a-random-32-byte-secret"
ROOMPIRE_FX_PROVIDER="frankfurter"
ROOMPIRE_FILE_STORAGE_PROVIDER="s3"
ROOMPIRE_S3_BUCKET="replace-with-private-file-bucket"
ROOMPIRE_S3_REGION="auto"
ROOMPIRE_S3_ENDPOINT="https://replace-with-account.r2.cloudflarestorage.com"
ROOMPIRE_S3_ACCESS_KEY_ID="replace-with-s3-access-key"
ROOMPIRE_S3_SECRET_ACCESS_KEY="replace-with-s3-secret-key"
ROOMPIRE_S3_FORCE_PATH_STYLE="false"
ROOMPIRE_SITE_GATE_USERNAME="replace-with-deployment-gate-username"
ROOMPIRE_SITE_GATE_PASSWORD="replace-with-deployment-gate-password"
ROOMPIRE_SITE_GATE_SESSION_EMAIL="replace-with-gate-user-email"
ROOMPIRE_WEB_PUSH_PUBLIC_KEY=""
ROOMPIRE_WEB_PUSH_PRIVATE_KEY=""
ROOMPIRE_WEB_PUSH_SUBJECT="mailto:admin@roompire.local"
ROOMPIRE_WEB_PUSH_DELIVERY_MODE="send"
ROOMPIRE_SMOKE_STATUS_STALE_MS=7200000
ROOMPIRE_RESTORE_DRILL_STATUS_STALE_MS=129600000
ROOMPIRE_BACKUP_FRESHNESS_STALE_MS=129600000
ROOMPIRE_SHARED_APP_STORAGE_STATUS_STALE_MS=172800000
ROOMPIRE_SHARED_APP_STORAGE_SKIP_PATHS=""
ROOMPIRE_CONTAINER_HEALTH_CONTAINERS="roompire-web-1 roompire-postgres-1 roompire-redis-1"
ROOMPIRE_RATE_LIMITS_ENABLED="true"
ROOMPIRE_RATE_LIMIT_DEV_SESSION_LIMIT=120
ROOMPIRE_RATE_LIMIT_DEV_SESSION_WINDOW_SECONDS=300
ROOMPIRE_RATE_LIMIT_INVITE_CREATE_LIMIT=20
ROOMPIRE_RATE_LIMIT_INVITE_CREATE_WINDOW_SECONDS=3600
ROOMPIRE_RATE_LIMIT_INVITE_ACCEPT_LIMIT=30
ROOMPIRE_RATE_LIMIT_INVITE_ACCEPT_WINDOW_SECONDS=600
ROOMPIRE_RATE_LIMIT_FILE_PRESIGN_LIMIT=60
ROOMPIRE_RATE_LIMIT_FILE_PRESIGN_WINDOW_SECONDS=3600
ROOMPIRE_RATE_LIMIT_PROPOSAL_COMMENT_LIMIT=120
ROOMPIRE_RATE_LIMIT_PROPOSAL_COMMENT_WINDOW_SECONDS=3600
ROOMPIRE_RATE_LIMIT_SHARE_DECISION_LIMIT=120
ROOMPIRE_RATE_LIMIT_SHARE_DECISION_WINDOW_SECONDS=600

ROOMPIRE_BACKUP_ENCRYPTION="disabled"
ROOMPIRE_BACKUP_ENCRYPTION_PASSPHRASE_FILE="/srv/aialra/secrets/roompire-backup-passphrase"
ROOMPIRE_BACKUP_REMOVE_PLAINTEXT="true"
ROOMPIRE_BACKUP_OFFSITE_MODE="disabled"
ROOMPIRE_BACKUP_OFFSITE_TARGET_DIR=""
ROOMPIRE_BACKUP_OFFSITE_RCLONE_REMOTE=""
ROOMPIRE_BACKUP_OFFSITE_STATUS_FILE="ops/status/backup-offsite.json"
ROOMPIRE_BACKUP_OFFSITE_ALLOW_SAME_FILESYSTEM="false"
ROOMPIRE_BACKUP_PASSPHRASE_ESCROW_STATUS_FILE="ops/status/backup-passphrase-escrow.json"
ROOMPIRE_BACKUP_PASSPHRASE_ESCROW_STALE_MS=15552000000
