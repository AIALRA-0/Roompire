ROOMPIRE_DOMAIN="roompire.aialra.online"
NEXT_PUBLIC_APP_URL="https://roompire.aialra.online"

POSTGRES_USER="roompire"
POSTGRES_PASSWORD="replace-with-a-strong-postgres-password"
POSTGRES_DB="roompire_prod"
DATABASE_URL="postgresql://roompire:replace-with-a-strong-postgres-password@postgres:5432/roompire_prod"
REDIS_URL="redis://redis:6379"

ROOMPIRE_ENABLE_DEV_AUTH="false"
ROOMPIRE_DEV_SESSION_EMAIL="alice@example.test"
ROOMPIRE_FILE_SIGNING_SECRET="replace-with-a-random-32-byte-secret"
ROOMPIRE_EXPORT_SIGNING_SECRET="replace-with-a-random-32-byte-secret"
ROOMPIRE_FX_PROVIDER="frankfurter"
ROOMPIRE_FILE_STORAGE_PROVIDER="s3"
ROOMPIRE_S3_BUCKET="replace-with-private-file-bucket"
ROOMPIRE_S3_REGION="auto"
ROOMPIRE_S3_ENDPOINT="https://replace-with-account.r2.cloudflarestorage.com"
ROOMPIRE_S3_ACCESS_KEY_ID="replace-with-s3-access-key"
ROOMPIRE_S3_SECRET_ACCESS_KEY="replace-with-s3-secret-key"
ROOMPIRE_S3_FORCE_PATH_STYLE="false"
ROOMPIRE_SITE_GATE_USERNAME="replace-with-deployment-gate-username"
ROOMPIRE_SITE_GATE_PASSWORD="replace-with-deployment-gate-password"
ROOMPIRE_SITE_GATE_SESSION_EMAIL="replace-with-gate-user-email"

ROOMPIRE_BACKUP_ENCRYPTION="disabled"
ROOMPIRE_BACKUP_ENCRYPTION_PASSPHRASE_FILE="/srv/aialra/secrets/roompire-backup-passphrase"
ROOMPIRE_BACKUP_REMOVE_PLAINTEXT="true"
